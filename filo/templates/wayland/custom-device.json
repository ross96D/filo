{
    "id": "filo_wayland",
    "label": "Filo Wayland",
    "sdkNameAndVersion": "Filo / Wayland (debug)",
    "platform": "${platform}",
    "enabled": true,
    "ping": [
        "dart",
        "wayland/tool/wayland.dart",
        "ping"
    ],
    "screenshot": [
        "dart",
        "wayland/tool/wayland.dart",
        "screenshot"
    ],
    "postBuild": [
        "dart",
        "wayland/tool/wayland.dart",
        "post-build",
        "${appName}",
        "${localPath}",
        "${buildMode}",
        "${icuDataPath}",
        "${engineRevision}"
    ],
    "install": [
        "/bin/true"
    ],
    "uninstall": [
        "/bin/true"
    ],
    "runDebug": [
        "build/wayland/${arch}/debug/bundle/${appName}"
    ]
}
